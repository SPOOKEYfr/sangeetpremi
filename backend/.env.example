# SangeetPremi backend — local development environment template.
# Copy to .env (gitignored) and fill in. NEVER commit real values.
# Phase B needs none of these to run — defaults are safe for local dev.

# PORT=8080
# HOST=127.0.0.1
# ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:5173
# MAX_BODY_BYTES=65536
# RATE_LIMIT_CLIENT_MAX=60
# RATE_LIMIT_CLIENT_WINDOW_MS=60000
# RATE_LIMIT_IP_MAX=120
# RATE_LIMIT_IP_WINDOW_MS=60000
# LOG_LEVEL=info

# Phase C (do NOT set until SPOOKEYfr provides credentials):
# YOUTUBE_API_KEY=
# YOUTUBE_OAUTH_CLIENT_ID=
